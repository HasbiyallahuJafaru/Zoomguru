# ZoomGuru Electron — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env — only commit .env.example.

# Backend URL (must match where the NestJS server is running)
VITE_API_URL=https://zoomguru-backend-production.up.railway.app

VITE_APP_ENV=development

# Paystack — get from dashboard.paystack.com
# Settings → API Keys & Webhooks → Public key (pk_live_... or pk_test_...)
VITE_PAYSTACK_PUBLIC_KEY=pk_live_your_public_key_here

# Admin dashboard URL used for broadcast deep-link in Dashboard
VITE_ADMIN_URL=https://your-admin-domain.com
