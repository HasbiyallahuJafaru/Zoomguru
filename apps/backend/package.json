{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "node -e \"require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})\" && nest build",
    "start": "node --use-system-ca dist/main",
    "test": "npx jest --runInBand",
    "test:coverage": "npx jest --runInBand --coverage"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.spec.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    }
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@neondatabase/serverless": "^0.9.3",
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.21",
    "@nestjs/schematics": "^11.1.0",
    "@sentry/node": "^10.53.1",
    "bcryptjs": "^2.4.3",
    "mammoth": "^1.7.2",
    "nanoid": "^3.3.12",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^1.1.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdf-parse": "^1.1.4",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.10",
    "typescript": "^5.3.0"
  }
}
