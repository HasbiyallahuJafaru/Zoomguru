# ─────────────────────────────────────────────
# ZoomGuru Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env — only commit .env.example.
# ─────────────────────────────────────────────

# Neon PostgreSQL — get from console.neon.tech
# → Your project → Connection Details → Connection string
#
# LOCAL DEV: use the direct connection string (ep-xxx.region.aws.neon.tech)
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#
# PRODUCTION (Render): use the POOLER connection string (ep-xxx-pooler.region.aws.neon.tech)
# console.neon.tech → Connection Details → toggle "Connection pooling" ON → copy string
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# JWT — any long random string (use: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# Required — Redis connection string for rate limiting and session caps
REDIS_URL=redis://localhost:6379

# DeepSeek — get from platform.deepseek.com
DEEPSEEK_API_KEY=sk-your_deepseek_key_here

# Groq — get from console.groq.com (free tier available)
# Used for Whisper speech-to-text and vision
GROQ_API_KEY=gsk_your_groq_key_here

PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
# Paystack — get from dashboard.paystack.com
# ─────────────────────────────────────────────

# Settings → API Keys & Webhooks → Secret key (sk_live_... or sk_test_...)
PAYSTACK_SECRET_KEY=sk_live_your_secret_key_here

# ─────────────────────────────────────────────
# Resend — transactional email service
# ─────────────────────────────────────────────

# get from resend.com → API Keys → Create API Key
# Public-facing backend URL — used in password reset email links.
# In production set this to your domain (e.g. https://zoomguru.xyz).
# Locally it falls back to http://localhost:3000.
APP_URL=https://zoomguru.xyz
RESEND_API_KEY=re_your_resend_api_key_here

# The verified sender address shown on all outgoing emails.
# During dev you can use onboarding@resend.dev (no domain verification needed).
# In production, set this to a domain you have verified in Resend.
FROM_EMAIL=noreply@zoomguru.xyz

# ─────────────────────────────────────────────
# Admin Dashboard — alto.zoomguru.xyz
# ─────────────────────────────────────────────

# Secret key required in x-admin-key header to access /admin/* endpoints.
# Generate with: openssl rand -hex 32
ADMIN_KEY=your_secret_admin_key_here

# CORS origin for the deployed admin dashboard.
ADMIN_CORS_ORIGIN=https://zoomguru-admin.vercel.app

# Origin for SSE CORS headers — set to app://zoomguru for production Electron
ELECTRON_ORIGIN=app://zoomguru

# ─────────────────────────────────────────────
# Cloudflare R2 — download redirect URLs
# ─────────────────────────────────────────────

# Direct public R2 URLs for each platform build.
# The /analytics/download?platform=windows endpoint redirects here.
R2_DOWNLOAD_URL_WINDOWS=https://your-r2-bucket-url/ZoomGuru-Setup.exe
R2_DOWNLOAD_URL_MAC=https://your-r2-bucket-url/ZoomGuru.dmg
